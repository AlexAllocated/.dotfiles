+#[test]
+fn pointer_coordinates_follow_surface_scale_without_reenter() {
+    use wayland_client::protocol::wl_pointer::Event as PointerEvent;
+
+    let mut f = TestFixture::new_pre_connect(|testwl| {
+        testwl.enable_fractional_scale();
+    });
+    let comp = f.compositor();
+    let pointer = TestObject::<WlPointer>::from_request(&comp.seat.obj, wl_seat::Request::GetPointer {});
+    let (_, desktop) = f.new_output(0, 0);
+    let (_, tablet) = f.new_output(3440, 0);
+    let (_, id) = f.create_toplevel(&comp, Window::new(1));
+    let fractional = f.testwl.get_surface_data(id).unwrap().fractional.clone().unwrap();
+    fractional.preferred_scale(120);
+    f.testwl.move_surface_to_output(id, &desktop);
+    f.run();
+    f.testwl.move_pointer_to(id, 40.0, 60.0);
+    f.run();
+    f.run();
+    pointer.data.events.lock().unwrap().clear();
+
+    // The shortcut can move a window beneath the pointer before its preferred
+    // scale arrives. Neither a scale change nor a resize requires another enter.
+    for (output, scale) in [(&tablet, 210), (&desktop, 120), (&tablet, 240), (&desktop, 120)] {
+        f.testwl.move_surface_to_output(id, output);
+        f.run();
+        fractional.preferred_scale(scale);
+        f.run();
+        f.testwl.pointer_motion(100.0, 200.0);
+        f.run();
+        f.run();
+        let events = pointer.data.events.lock().unwrap();
+        assert!(events.iter().all(|event| !matches!(event, PointerEvent::Enter { .. })));
+        let motion = events.iter().rev().find_map(|event| match event {
+            PointerEvent::Motion { surface_x, surface_y, .. } => Some((*surface_x, *surface_y)),
+            _ => None,
+        });
+        let factor = f64::from(scale) / 120.0;
+        assert_eq!(motion, Some((100.0 * factor, 200.0 * factor)));
+        drop(events);
+        pointer.data.events.lock().unwrap().clear();
+    }
+}
