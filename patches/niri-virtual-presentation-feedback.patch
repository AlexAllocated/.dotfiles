+    /// Virtual outputs are presented by their capture consumers, not a KMS scanout.
+    /// Use the successful capture's visibility states, and wait for rendering to
+    /// finish before acknowledging it. Never acknowledge hidden/occluded surfaces
+    /// or claim hardware timing for a virtual display.
+    pub fn present_virtual_output(
+        &mut self,
+        output: &Output,
+        states: &RenderElementStates,
+        sync: Option<SyncPoint>,
+    ) {
+        use smithay::reexports::wayland_protocols::wp::presentation_time::server::wp_presentation_feedback;
+        use smithay::wayland::presentation::Refresh;
+
+        if !crate::backend::VirtualOutputMarker::is_virtual(output) {
+            return;
+        }
+
+        self.update_primary_scanout_output(output, states);
+        let mut feedback = self.take_presentation_feedbacks(output, states);
+        let mut presented = move || {
+            feedback.presented::<_, Monotonic>(
+                get_monotonic_time(),
+                Refresh::Unknown,
+                0,
+                wp_presentation_feedback::Kind::empty(),
+            );
+        };
+
+        if let Some(sync) = sync {
+            if !sync.is_reached() {
+                if let Some(fd) = sync.export() {
+                    let output = output.clone();
+                    let source = Generic::new(fd, Interest::READ, Mode::OneShot);
+                    if let Err(err) = self.event_loop.insert_source(source, move |_, _, state| {
+                        if state.niri.monitors_active
+                            && state.niri.output_state.contains_key(&output)
+                        {
+                            presented();
+                        }
+                        Ok(PostAction::Remove)
+                    }) {
+                        warn!("error waiting for virtual output presentation: {err}");
+                    }
+                    return;
+                }
+                if let Err(err) = sync.wait() {
+                    warn!("error completing virtual output presentation: {err:?}");
+                    return;
+                }
+            }
+        }
+        presented();
+    }
