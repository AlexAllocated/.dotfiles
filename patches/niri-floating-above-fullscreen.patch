+#[test]
+fn floating_above_fullscreen_visibility_and_input() {
+    for enabled in [false, true] {
+        let options = Options {
+            layout: niri_config::Layout {
+                floating_above_fullscreen: enabled,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let layout = check_ops_with_options(options, [
+            Op::AddOutput(1),
+            Op::AddWindow { params: TestWindowParams::new(1) },
+            Op::FullscreenWindow(1),
+            Op::AddWindow { params: TestWindowParams::new(2) },
+            Op::SetWindowFloating { id: Some(2), floating: true },
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::FocusWindow(1),
+            Op::CompleteAnimations,
+        ]);
+        let ws = layout.active_workspace().unwrap();
+        assert!(ws.render_above_top_layer());
+        assert_eq!(ws.is_floating_visible(), enabled);
+        let (tile, pos) = ws.floating().tiles_with_render_positions().next().unwrap();
+        let point = pos + Point::from((tile.tile_size().w / 2., tile.tile_size().h / 2.));
+        let (window, _) = ws.window_under(point).unwrap();
+        assert_eq!(*window.id(), if enabled { 2 } else { 1 });
+        assert_eq!(ws.active_window().unwrap().id(), &1);
+    }
+}
