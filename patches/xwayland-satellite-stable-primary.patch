+fn select_primary_output(
+    outputs: &HashMap<String, xcb::randr::Output>,
+    preferred: &str,
+    current: xcb::randr::Output,
+) -> Option<xcb::randr::Output> {
+    outputs.get(preferred).copied()
+        .or_else(|| outputs.values().copied().find(|output| *output == current))
+        .or_else(|| outputs.iter().min_by_key(|(name, _)| *name).map(|(_, output)| *output))
+}
