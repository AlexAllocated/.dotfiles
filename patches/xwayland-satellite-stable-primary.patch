+#[test]
+fn stable_primary_output_tracks_hotplug_not_focus() {
+    let desktop = xcb::randr::Output::new(1);
+    let tablet = xcb::randr::Output::new(2);
+    let mut outputs = HashMap::from([("DP-4".into(), desktop), ("Moonlight".into(), tablet)]);
+    assert_eq!(select_primary_output(&outputs, "DP-4", tablet), Some(desktop));
+    outputs.remove("DP-4");
+    assert_eq!(select_primary_output(&outputs, "DP-4", desktop), Some(tablet));
+    assert_eq!(select_primary_output(&outputs, "DP-4", tablet), Some(tablet));
+    outputs.insert("DP-4".into(), desktop);
+    assert_eq!(select_primary_output(&outputs, "DP-4", tablet), Some(desktop));
+    outputs.clear();
+    assert_eq!(select_primary_output(&outputs, "DP-4", desktop), None);
+}
