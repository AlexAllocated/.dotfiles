+
+fn refresh_output_scale(output: Entity, state: &mut ServerState<impl XConnection>) {
+    let factor = {
+        let Ok(dimensions) = state.world.get::<&OutputDimensions>(output) else { return; };
+        let Some((logical_width, logical_height)) = dimensions.logical_size else { return; };
+        if dimensions.width <= 0 || dimensions.height <= 0 || logical_width <= 0 || logical_height <= 0 {
+            return;
+        }
+        let (width, height) = if dimensions.rotated_90 {
+            (dimensions.height, dimensions.width)
+        } else {
+            (dimensions.width, dimensions.height)
+        };
+        // Logical dimensions are rounded to whole pixels. Recover the protocol's
+        // 1/120 scale granularity rather than manufacturing a slightly different DPI.
+        ((width as f64 / logical_width as f64 + height as f64 / logical_height as f64)
+            * 60.0).round() / 120.0
+    };
+    if (0.5..=8.0).contains(&factor) && update_output_scale(
+        state.world.query_one(output).unwrap(), OutputScaleFactor::Fractional(factor),
+    ) {
+        state.updated_outputs.push(output);
     }
 }
 
