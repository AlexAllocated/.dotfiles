+/*
+ * Vesktop, a desktop app aiming to give you a snappier Discord Experience
+ * Copyright (c) 2023 Vendicated and Vencord contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Keep all navigation on Discord, including URLs received from local RPC.
+export function discordNavigationUrl(uri: string | undefined, branch?: string): string {
+    const host = branch === "canary" || branch === "ptb" ? `${branch}.discord.com` : "discord.com";
+    const target = new URL(`https://${host}/app`);
+    if (!uri) return target.href;
+
+    const input = new URL(uri);
+    if (input.protocol !== "discord:" &&
+        !(input.protocol === "https:" && /^(?:(?:canary|ptb)\.)?discord\.com$/.test(input.hostname))) {
+        throw new Error("Unsupported Discord link");
+    }
+    if (input.username || input.password || input.port) throw new Error("Invalid Discord link");
+    target.pathname = input.pathname === "/" || !input.pathname ? "/app" : input.pathname;
+    target.search = input.search;
+    target.hash = input.hash;
+
+    // Discord's standalone bot installer attempts another desktop handoff when
+    // response_type is absent from the search string. A Vesktop-only marker
+    // suppresses that handoff without changing OAuth response_type or grants.
+    if (target.pathname === "/oauth2/authorize" && !target.searchParams.has("response_type")) {
+        target.searchParams.set("vesktop_response_type", "bot");
+    }
+    return target.href;
+}
+
+export function oauthDeepLink(data: unknown): string | undefined {
+    if (!data || typeof data !== "object" || !("type" in data) || data.type !== "OAUTH2") return;
+    if (!("params" in data) || !data.params || typeof data.params !== "object" || !("search" in data.params)) return;
+    const search = data.params.search;
+    if (typeof search !== "string" || !search.startsWith("?") || search.length > 16384) return;
+    return discordNavigationUrl("discord://action/oauth2/authorize" + search);
+}
