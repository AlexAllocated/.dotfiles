#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
	SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
	SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
	[[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
REPO_ROOT="${DOTFILES_ROOT:-$(cd -P "$SCRIPT_DIR/.." && pwd)}"
if [[ ! -f "$REPO_ROOT/scripts/dotfiles/cli.py" ]]; then
	printf 'No dotfiles controller in the selected checkout: %s\n' "$REPO_ROOT" >&2
	exit 1
fi
exec python3 "$REPO_ROOT/scripts/dotfiles/cli.py" "$@"
