{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "AudioArray",
	"version": "0.1.0",
	"identifier": "ai.hivetech.audioarray",
	"build": {
		"frontendDist": "../web"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "AudioArray / LCARS 47-A",
				"width": 1480,
				"height": 920,
				"minWidth": 600,
				"minHeight": 480,
				"center": true,
				"visible": false,
				"resizable": true,
				"backgroundColor": "#000000"
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
		}
	},
	"bundle": {
		"active": false
	}
}
