{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"noEmit": true
	},
	"include": ["src"]
}
